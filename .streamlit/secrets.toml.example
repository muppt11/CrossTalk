# Copy this file to .streamlit/secrets.toml and add your own key(s).
OPENAI_API_KEY = "sk-proj-your-key-here"

# Optional and free: a classic GitHub personal access token (no scopes needed for public
# repos). Raises the GitHub API rate limit from 60 requests/hour to 5,000/hour.
GITHUB_TOKEN = "ghp_your-token-here"

# Optional, for the "Connect GitHub" sign-in button in the web version. Register an OAuth App
# (see README) with callback URL http://127.0.0.1:8600/auth/callback and paste its values here.
GITHUB_CLIENT_ID = "your-client-id"
GITHUB_CLIENT_SECRET = "your-client-secret"
